# Copy to .env and fill in the secrets. .env is gitignored; this file is not.
# Full setup runbook: documentation/self-hosted-ml-models.md

# Cloudflare R2 mirror for ML model weights.
R2_ACCOUNT_ID=
R2_BUCKET=safewebtool-models

# Public read host — the r2.dev development URL, or the custom domain in production.
R2_PUBLIC_HOST=

# R2 -> Manage API Tokens -> Object Read & Write, scoped to the one bucket.
# Used only by `npm run sync:models`, never by the browser.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Client-side switch. Set to the same value as R2_PUBLIC_HOST to serve weights
# from the mirror; leave unset to fall back to huggingface.co.
VITE_MODEL_HOST=
